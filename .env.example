# ==============================================================================
# AI-Powered Phishing Protection System - Environment Configuration
# ==============================================================================
# Copy this file to '.env' in your local environment.
# IMPORTANT: Never commit '.env' to version control. Keep all secrets secure.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS
# In development, allow localhost for the dashboard and the chrome-extension protocol
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","chrome-extension://*"]
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Machine Learning Engine Configuration
MODEL_PATH=ml/models/xgboost_phishing_model.json
EXPLAINER_PATH=ml/models/shap_explainer.joblib
FEATURE_CONFIG_PATH=ml/models/feature_config.json

# Risk Thresholds (0.0 to 1.0)
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_HIGH=0.70

# Database Configuration (SQLite default for simple local setup)
DATABASE_URL=sqlite:///./phishing_protection.db
