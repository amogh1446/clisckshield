{
  "manifest_version": 3,
  "name": "AI Phishing Protection System",
  "version": "0.1.0",
  "description": "Real-time AI-powered protection against deceptive phishing sites and credential theft.",
  "permissions": [
    "webNavigation",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI Phishing Protection",
    "default_popup": "popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning/warning.html",
        "warning/warning.css",
        "warning/warning.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
