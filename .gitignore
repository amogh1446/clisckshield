# Machine Learning Artifacts & Datasets
# Model binaries and large dataset files must not be tracked in Git
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.bin
ml/models/*.onnx
ml/models/*.json
!ml/models/.gitkeep

ml/data/*.csv
ml/data/*.parquet
ml/data/*.zip
ml/data/*.tar.gz
!ml/data/.gitkeep
!ml/data/README.md

